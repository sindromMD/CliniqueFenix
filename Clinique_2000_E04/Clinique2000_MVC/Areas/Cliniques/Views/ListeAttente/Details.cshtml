@inject Clinique2000_Services.IServices.IClinique2000Services _service;
@using Clinique2000_Utility.Constants;
@using System.Security.Claims;
@model Clinique2000_Core.ViewModels.ListeAttenteVM


<section id="heroDetails" class="d-flex align-items-center justify-content-center mb-2">

    <div class="listeattente-data">
        <div class="row d-flex my-5 justify-content-center align-content-center text-center"> 
            <div class="col-8 mt-5">
                <h1 class="text-center justify-content-center">Liste d'attente</h1>
                <h1 class="text-center justify-content-center">@Model.ListeAttente.Clinique.NomClinique</h1>
                <h2 class="text-center justify-content-center">@Model.ListeAttente.Clinique.Adresse.Numero, @Model.ListeAttente.Clinique.Adresse.Rue @Model.ListeAttente.Clinique.Adresse.Ville @Model.ListeAttente.Clinique.Adresse.CodePostal </h2>
                
            </div>
        </div>
        <!-- Facts Start -->
        <div class="container-fluid facts py-5 pt-lg-0">
            <div class="container py-5 pt-lg-0">
                <div class="row gx-0">
                    <div class="col-lg-4 wow zoomIn" data-wow-delay="0.1s">
                        <div class="bg-primary shadow d-flex align-items-center justify-content-center p-4" style="height: 200px;">
                            <div class="ps-4">
                                <div class="timeDiv ">
                                    <span class="font-color-clock-white" id="time"></span>
                                    <span class="font-color-clock-white" id="sec"></span>
                                    <span class="font-color-clock-white" id="med"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 wow zoomIn" data-wow-delay="0.3s">
                        <div class="bg-light shadow d-flex align-items-center justify-content-center p-4" style="height: 200px;">
                            <div class="ps-4">
                                <h5 class="text-primary mb-0">Effective le:</h5>
                                <h2 class="mb-0" data-toggle="counter-up">@Model.ListeAttente.DateEffectivite.ToString("yyyy-MM-dd")</h2>
                                <div class="row">
                                     <div class="col-6">
                                        <h5 class="text-primary mb-0">Ouvre à:</h5>
                                        <h2 class="mb-0" data-toggle="counter-up">@Model.ListeAttente.HeureOuverture.ToString("hh\\:mm")</h2>
                                     </div>
                                    <div class="col-6">
                                        <h5 class="text-primary mb-0">Ferme à:</h5>
                                        <h2 class="mb-0" data-toggle="counter-up">@Model.ListeAttente.HeureFermeture.ToString("hh\\:mm")</h2>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 wow zoomIn" data-wow-delay="0.6s">
                        <div class="bg-primary shadow d-flex align-items-center justify-content-center p-4" style="height: 200px;">
                            <div class="bg-white d-flex align-items-center justify-content-center rounded mb-2" style="width: 60px; height: 60px;">
                                <i class="fa-solid fa-stethoscope fa-2xl" style="color: #0d6efd;"></i>
                            </div>
                            <div class="ps-4">
                                <h5 class="text-white mb-0">Nombre de médecins: </h5>
                                <h1 class="text-white mb-0" data-toggle="counter-up">@Model.ListeAttente.NbMedecinsDispo</h1>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (this.User.Identity.IsAuthenticated)
        {

            var email = User.FindFirstValue(ClaimTypes.Email);
            var estPatient = await _service.patient.UserAuthEstPatientAsync();
            var employe = await _service.employesClinique.VerifierSiUserAuthEstEmploye(email);
            if (!estPatient)
            {
                <div class="row justify-content-center text-center m-2">
                    <div class="col-sm-8 col-lg-3">
                <form  asp-action="AjouterDesPlagesHoraires" asp-controller="ListeAttente" method="post">
                    <input type="hidden" name="id" value="@Model.ListeAttente.ListeAttenteID" />
                    <input id="btn-ph" type="submit" value="Generer plages horaire" class="btn button-green-action " @(Model.PlagesHoraires?.Count > 0 ? "disabled" : "") />
                </form>
            </div>
           
            <div class="col-sm-8 col-lg-3">
                <a asp-area="Cliniques" asp-controller="ListeAttente" asp-action="IndexlisteSalleAttente" asp-route-listeAttenteID=1 class="button-blue-action">
                    Voir Liste Salle d'attente
                </a>
            </div>         
        </div>
        }
        }

        <div class="row justify-content-center text-center">
            <div class="col-sm-8 col-lg-3">
                <a class="smBtn button-white-action" asp-action="Index" asp-controller="Home" asp-area="">Retour à l'accueil</a> 
@*                <form asp-action="ChangerStatutConsultation" asp-controller="ListeAttente" asp-area="Cliniques" method="post">
                    <input asp-for="@Model.ListeAttente.Consultations.FirstOrDefault().ConsultationID " value="1" class="form-control" type="hidden"/>
                    <button type="submit" class="smBtn button-white-action" id="PasserPatient" data-consultationid=1>Passer le prochain patient</button>
                </form>
                <a id="PasserPatient" type="button" class="text-center justify-content-center d-block my-5"
                   data-consultationid=1>
                    Passer le prochain patient
                </a>*@
            </div> 
            
@*            <div class="col-sm-8 col-lg-3">

            </div>*@
        </div>
    </div>
</section>

<div class="layout-content">
    <div class="container flex-grow-1 container-p-y">
        @if (Model.EstPatientSeulement)
        {
            @if (Model.MonRendezVousAujourdhui != null)
            {
                var rendezVous = Model.MonRendezVousAujourdhui;
                <section class="card rdv-card mb-4" aria-labelledby="rdv-card-title">
                    <div class="card-header card-header-datatables h4 text-light d-flex align-items-center gap-2">
                        <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                        <h2 class="h4 mt-2 mb-2" id="rdv-card-title">Mon prochain rendez-vous</h2>
                    </div>
                    <div class="card-body">
                        <dl class="row g-3 p-3 mb-0">
                            <dt class="col-sm-3 hr5"><i class="fa-solid fa-calendar-days me-2" aria-hidden="true"></i>Date</dt>
                            <dd class="col-sm-9 p1">@rendezVous.HeureDateDebutPrevue.ToString("dd/MM/yyyy")</dd>
                            <dt class="col-sm-3 hr5"><i class="fa-solid fa-clock me-2" aria-hidden="true"></i>Heure</dt>
                            <dd class="col-sm-9 p1">@rendezVous.HeureDateDebutPrevue.ToString("HH:mm")</dd>
                            <dt class="col-sm-3 hr5"><i class="fa-solid fa-location-dot me-2" aria-hidden="true"></i>Lieu</dt>
                            <dd class="col-sm-9 p1">
                                @Model.ListeAttente.Clinique.NomClinique —
                                @Model.ListeAttente.Clinique.Adresse.Numero @Model.ListeAttente.Clinique.Adresse.Rue,
                                @Model.ListeAttente.Clinique.Adresse.Ville @Model.ListeAttente.Clinique.Adresse.CodePostal
                            </dd>
                        </dl>

                        @if (Model.PeutAnnulerMonRendezVous)
                        {
                            <button type="button"
                                    class="btn btn-outline-danger rdv-card__cancel"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#confirmationAnnulation"
                                    aria-expanded="false"
                                    aria-controls="confirmationAnnulation">
                                Annuler le rendez-vous
                            </button>
                            <div class="collapse mt-3" id="confirmationAnnulation">
                                <div class="alert alert-light border mb-0">
                                    <p class="mb-3">Annuler votre rendez-vous de @rendezVous.HeureDateDebutPrevue.ToString("HH:mm") ?</p>
                                    <div class="d-flex flex-wrap gap-2">
                                        <form asp-area="Cliniques"
                                              asp-controller="ListeAttente"
                                              asp-action="AnnulerMonRendezVous"
                                              method="post">
                                            <input type="hidden" name="consultationId" value="@rendezVous.ConsultationID" />
                                            <input type="hidden" name="listeAttenteId" value="@Model.ListeAttente.ListeAttenteID" />
                                            <button type="submit" class="btn btn-danger rdv-card__confirm">Oui, annuler</button>
                                        </form>
                                        <button type="button"
                                                class="button-white-action"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#confirmationAnnulation"
                                                aria-controls="confirmationAnnulation">
                                            Conserver mon rendez-vous
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mt-3 mb-0">L'annulation n'est plus possible après l'heure du rendez-vous.</p>
                        }
                    </div>
                </section>

                <div class="alert alert-light border" role="status">
                    <i class="fa-solid fa-circle-info text-primary me-2" aria-hidden="true"></i>
                    Vous avez déjà un rendez-vous aujourd'hui dans cette clinique. Les autres créneaux ne sont donc pas affichés.
                </div>
            }
            else
            {
                <section aria-labelledby="available-slots-title">
                    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
                        <div>
                            <h2 id="available-slots-title" class="h3 mb-1">Créneaux disponibles</h2>
                            <p class="text-muted mb-0">Choisissez l'heure qui vous convient.</p>
                        </div>
                    </div>

                    <div class="alert alert-light border" role="note">
                        Vous pouvez réserver un seul rendez-vous par jour dans cette clinique.
                    </div>

                    @if (Model.CreneauxDisponibles.Count == 0)
                    {
                        <div class="card">
                            <div class="card-body p-4">
                                <p class="p1 mb-0">Aucun créneau n'est disponible pour cette date.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
                            @foreach (var creneau in Model.CreneauxDisponibles)
                            {
                                <div class="col">
                                    <article class="card h-100 slot-card">
                                        <div class="card-body d-flex flex-column gap-2">
                                            <h3 class="slot-card__time mb-0">@creneau.HeureDebut.ToString("HH:mm")</h3>
                                            @if (creneau.NombrePlacesDisponibles > 0)
                                            {
                                                <p class="p2 mb-2">
                                                    @creneau.NombrePlacesDisponibles place@(creneau.NombrePlacesDisponibles > 1 ? "s" : "")
                                                </p>
                                                <form class="mt-auto"
                                                      asp-area="Cliniques"
                                                      asp-controller="ListeAttente"
                                                      asp-action="ShowReservationConfirmation"
                                                      asp-route-id="@creneau.ConsultationDisponibleID"
                                                      method="get">
                                                    <button type="submit" class="button-green-action w-100">Réserver</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <p class="p2 mb-2">Aucune place disponible</p>
                                                <button type="button" class="btn btn-secondary w-100 slot-card__full" disabled>Complet</button>
                                            }
                                        </div>
                                    </article>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        }
        else
        {
            <section aria-labelledby="consultations-title">
                <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
                    <div>
                        <h2 id="consultations-title" class="h3 mb-1">Consultations</h2>
                        <p class="text-muted mb-0">Vue complète des créneaux de la clinique.</p>
                    </div>
                </div>

                @if (Model.PlagesHoraires == null || !Model.PlagesHoraires.Any())
                {
                    <div class="card">
                        <div class="card-body p-4">
                            <p class="p1 mb-0">Aucun créneau n'a été généré pour cette date.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-xl-2 g-3">
                        @foreach (var plage in Model.PlagesHoraires)
                        {
                            <div class="col">
                                <article class="card">
                                    <div class="card-header p-3">
                                        <h3 class="h5 mt-1 mb-0">
                                            <i class="fa-solid fa-clock me-2 icons-details-patient" aria-hidden="true"></i>
                                            @plage.HeureDebut.ToString("HH:mm")
                                        </h3>
                                    </div>
                                    <div class="card-body">
                                        <partial name="_PartialAjouterDesConsultations" for="@plage.Consultations" />
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>
</div>
