@model ListeAttente;
@{
    Layout = "_Layout";
    var btnText = "Créer la liste d'attente";
    var cliniques = ViewData["Cliniques"] as SelectList ?? new SelectList(Array.Empty<SelectListItem>());
    var chargerValeursInitiales = (bool?)ViewData["ChargerValeursInitiales"] ?? false;
}

@{
    var isOuverteSelectList = new SelectList(new[]
    {
        new { Value = "true", Text = "Oui" },
        new { Value = "false", Text = "Non" }
    }, "Value", "Text");
}

<div class="container">
    <main role="main" class="pb-3">
        <div class="container-fluid">
            <div class="row justify-content-around">
                <div class="col col-lg-10 col-xl-9">

                    <div>
                        <h1 class="h0 text-center" style="margin-top:50px;">Créer une liste d'attente</h1>
                        <div class="divider-2 mb-3"></div><!--devider linear gradient cian-->

                        <p class="p1 text-center">
                            Veuillez compléter ces informations <br />
                            <span class="p3" style="color:black">Les champs marqués d'un astérisque (<span class="champs-obligatoires">*</span>) doivent être renseignés.</span>
                        </p>
                    </div>

                    <form asp-area="Cliniques" enctype="multipart/form-data" asp-controller="ListeAttente" asp-action="Create" method="post" class="m-4 p1">
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-3">
                            <label asp-for="CliniqueID" class="form-label">Clinique<span class="champs-obligatoires"> *</span></label>
                            <select asp-for="CliniqueID" asp-items="cliniques"
                                    class="form-control" id="cliniqueSelection"
                                    data-load-defaults="@chargerValeursInitiales">
                                <option value="">Sélectionnez une clinique</option>
                            </select>
                            <span asp-validation-for="CliniqueID" class="text-danger"></span>
                            <div class="text-danger" data-clinic-defaults-error role="alert" hidden></div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="IsOuverte" class="form-label">Disponible pour réservation<span class="champs-obligatoires"> *</span></label>
                            @Html.DropDownListFor(model => model.IsOuverte, isOuverteSelectList, new { @class = "form-control" })
                            <span asp-validation-for="IsOuverte" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="DateEffectivite" class="form-label">Date d'effectivité<span class="champs-obligatoires"> *</span></label>
                            <input min="@DateTime.Today.ToString("yyyy-MM-dd")" type="date" asp-for="DateEffectivite" class="form-control form-control-lg" id="dateEffectivite">
                            <span asp-validation-for="DateEffectivite" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="HeureOuverture" class="form-label">Heure d'ouverture<span class="champs-obligatoires"> *</span></label>
                            <input type="time" asp-for="HeureOuverture" class="form-control form-control-lg" id="heureOuverture">
                            <span asp-validation-for="HeureOuverture" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3" id="heureFermetureContainer">
                            <label asp-for="HeureFermeture" class="form-label">Heure de fermeture<span class="champs-obligatoires"> *</span></label>
                            <input type="time" asp-for="HeureFermeture" id="heureFermeture" class="form-control form-control-lg">
                            <span asp-validation-for="HeureFermeture" class="text-danger"></span>
                        </div>


                        <div class="form-group mb-3">
                            <label asp-for="NbMedecinsDispo" class="form-label">Nombre de médecins disponibles<span class="champs-obligatoires"> *</span></label>
                            <input type="number" asp-for="NbMedecinsDispo" id="nbMedecinsDispo" class="form-control form-control-lg" min="0" placeholder="Entrez le nombre de médecins disponibles">
                            <span asp-validation-for="NbMedecinsDispo" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="HeurePauseDebut" class="form-label">Début pause dîner</label>
                            <input type="time" asp-for="HeurePauseDebut" class="form-control form-control-lg" id="heurePauseDebut">
                            <span asp-validation-for="HeurePauseDebut" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="HeurePauseFin" class="form-label">Fin pause dîner</label>
                            <input type="time" asp-for="HeurePauseFin" id="heurePauseFin" class="form-control form-control-lg">
                            <span asp-validation-for="HeurePauseFin" class="text-danger"></span>
                        </div>

                        <!--CreateBTN-->
                        <div class="row justify-content-center text-center">
                            <div class="col col-md-8 col-xl-6 mb-2 mt-4">
                                <partial name="_SubmitButtonPartial" model="@btnText" />
                            </div>
                        </div>
                        <div class="row justify-content-center text-center">
                            <div class="col col-md-8 col-xl-6 my-2">
                                <partial name="_ResetButtonPartial" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    (() => {
        const clinicSelect = document.getElementById("cliniqueSelection");
        const error = document.querySelector("[data-clinic-defaults-error]");
        const defaultsUrl = '@Url.Action("ParametresCreation", "ListeAttente", new { area = "Cliniques" })';
        const fields = {
            dateEffectivite: document.getElementById("dateEffectivite"),
            heureOuverture: document.getElementById("heureOuverture"),
            heureFermeture: document.getElementById("heureFermeture"),
            nbMedecinsDispo: document.getElementById("nbMedecinsDispo"),
            heurePauseDebut: document.getElementById("heurePauseDebut"),
            heurePauseFin: document.getElementById("heurePauseFin")
        };

        async function chargerValeursClinique() {
            error.hidden = true;
            error.textContent = "";
            if (!clinicSelect.value) {
                return;
            }

            try {
                const url = new URL(defaultsUrl, window.location.origin);
                url.searchParams.set("cliniqueId", clinicSelect.value);
                const response = await fetch(url, {
                    headers: { "Accept": "application/json" },
                    credentials: "same-origin",
                    cache: "no-store"
                });
                if (!response.ok) {
                    throw new Error(response.status === 403
                        ? "Vous n’êtes pas autorisé à créer une liste pour cette clinique."
                        : "Impossible de charger les paramètres de cette clinique.");
                }

                const defaults = await response.json();
                Object.entries(fields).forEach(([name, field]) => {
                    field.value = defaults[name] ?? "";
                });
            } catch (requestError) {
                error.textContent = requestError.message;
                error.hidden = false;
                console.error("Impossible de charger les valeurs par défaut de la clinique.", requestError);
            }
        }

        clinicSelect.addEventListener("change", chargerValeursClinique);
        if (clinicSelect.value && clinicSelect.dataset.loadDefaults === "True") {
            chargerValeursClinique();
        }

        fields.heureOuverture.addEventListener("change", () => {
            const openingTime = fields.heureOuverture.value;
            const closingTime = fields.heureFermeture.value;
            if (openingTime && closingTime && closingTime <= openingTime) {
                fields.heureFermeture.value = "";
            }
        });

        fields.heureFermeture.addEventListener("blur", () => {
            const openingTime = fields.heureOuverture.value;
            const closingTime = fields.heureFermeture.value;
            if (openingTime && closingTime && closingTime <= openingTime) {
                alert("L'heure de fermeture doit être postérieure à l'heure d'ouverture.");
                fields.heureFermeture.value = "";
                fields.heureFermeture.focus();
            }
        });
    })();
</script>
