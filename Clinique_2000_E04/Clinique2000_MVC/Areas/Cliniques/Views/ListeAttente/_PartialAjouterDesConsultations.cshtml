@model IEnumerable<Clinique2000_Core.Models.Consultation>

<div class="d-flex flex-column gap-3">
    @foreach (var consultation in Model)
    {
        <article class="border rounded p-3">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-8">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <small class="d-block text-uppercase text-muted">Médecin</small>
                            <strong>
                                @if (consultation.EmployeClinique != null)
                                {
                                    @($"{consultation.EmployeClinique.EmployeCliniquePrenom} {consultation.EmployeClinique.EmployeCliniqueNom}")
                                }
                                else
                                {
                                    @:—
                                }
                            </strong>
                        </div>
                        <div class="col-sm-6">
                            <small class="d-block text-uppercase text-muted">Patient</small>
                            <strong>
                                @if (consultation.Patient != null)
                                {
                                    @($"{consultation.Patient.Prenom} {consultation.Patient.Nom}")
                                }
                                else
                                {
                                    @:—
                                }
                            </strong>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4 d-flex align-items-center justify-content-md-end">
                    @if (consultation.StatutConsultation == Clinique2000_Utility.Enum.StatutConsultation.DisponiblePourReservation)
                    {
                        <form class="w-100" asp-action="ReserverConsultation"
                              asp-controller="ListeAttente"
                              asp-area="Cliniques"
                              method="post">
                            <input type="hidden" name="id" value="@consultation.ConsultationID" />
                            <button type="submit" class="button-green-action w-100">Réserver</button>
                        </form>
                    }
                    else if (consultation.StatutConsultation == Clinique2000_Utility.Enum.StatutConsultation.Annulle)
                    {
                        <span class="badge rounded-pill text-bg-secondary">Annulé</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill text-bg-primary">Réservé</span>
                    }
                </div>
            </div>
        </article>
    }
</div>
