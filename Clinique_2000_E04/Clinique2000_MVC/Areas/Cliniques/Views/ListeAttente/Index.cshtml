@model Clinique2000_Core.ViewModels.ListeAttenteDashboardVM

@{
    ViewData["Title"] = "Tableau de bord des listes d'attente";
}

<main class="waiting-dashboard container py-5">
    <header class="waiting-dashboard__header">
        <div>
            <p class="waiting-dashboard__eyebrow mb-2">Espace clinique</p>
            <h1 class="mb-2">Tableau de bord</h1>
            <p class="text-muted mb-0">Suivez les listes d'attente et l'activité de vos cliniques.</p>
        </div>

        <section class="waiting-dashboard__profile" aria-label="Informations du compte">
            <div class="waiting-dashboard__avatar" aria-hidden="true">
                <i class="fa-solid fa-user"></i>
            </div>
            <div class="min-w-0">
                <h2 class="h5 mb-1 text-truncate">@Model.NomUtilisateur</h2>
                <p class="mb-2 text-muted text-truncate">@Model.Courriel</p>
                <div class="d-flex flex-wrap gap-1">
                    @if (Model.Roles.Count == 0)
                    {
                        <span class="badge text-bg-secondary">Personnel clinique</span>
                    }
                    else
                    {
                        @foreach (var role in Model.Roles)
                        {
                            <span class="badge text-bg-primary">@role</span>
                        }
                    }
                </div>
            </div>
        </section>
    </header>

    <section class="mt-5" aria-labelledby="waiting-lists-title">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
            <div>
                <p class="waiting-dashboard__eyebrow mb-1">Gestion</p>
                <h2 class="h3 mb-0" id="waiting-lists-title">Listes d'attente</h2>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-area="Cliniques" asp-controller="ListeAttente" asp-action="Create" class="button-green-action">
                    <i class="fa-solid fa-plus me-2" aria-hidden="true"></i>Créer une liste
                </a>
                <a asp-area="Cliniques" asp-controller="ListeAttente" asp-action="HistoriqueListeAttentes"
                   class="button-white-action" aria-label="Consulter l'historique des listes d'attente">
                    <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
                </a>
            </div>
        </div>

        @if (Model.ListesAttente.Count == 0)
        {
            <div class="card waiting-dashboard__empty">
                <div class="card-body p-4">
                    <i class="fa-regular fa-calendar-xmark fa-2x text-primary mb-3" aria-hidden="true"></i>
                    <h3 class="h5">Aucune liste d'attente à venir</h3>
                    <p class="text-muted mb-0">Les listes de vos cliniques apparaîtront ici.</p>
                </div>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-xl-2 g-4">
                @foreach (var liste in Model.ListesAttente)
                {
                    <div class="col">
                        <article class="card waiting-list-card h-100">
                            <header class="waiting-list-card__header">
                                <div class="min-w-0">
                                    <p class="waiting-dashboard__eyebrow mb-1">Clinique</p>
                                    <h3 class="h4 mb-0 text-truncate">@liste.NomClinique</h3>
                                </div>
                                <span class="badge rounded-pill @(liste.IsOuverte ? "text-bg-success" : "text-bg-secondary")">
                                    @(liste.IsOuverte ? "Ouverte" : "Fermée")
                                </span>
                            </header>

                            <div class="card-body">
                                <dl class="waiting-list-card__schedule mb-4">
                                    <div>
                                        <dt>Date d'effectivité</dt>
                                        <dd>@liste.DateEffectivite.ToString("dd/MM/yyyy")</dd>
                                    </div>
                                    <div>
                                        <dt>Ouverture</dt>
                                        <dd>@liste.HeureOuverture.ToString(@"hh\:mm")</dd>
                                    </div>
                                    <div>
                                        <dt>Fermeture</dt>
                                        <dd>@liste.HeureFermeture.ToString(@"hh\:mm")</dd>
                                    </div>
                                </dl>

                                <div class="waiting-list-card__stats">
                                    <div class="waiting-list-card__doctors">
                                        <i class="fa-solid fa-user-doctor" aria-hidden="true"></i>
                                        <div>
                                            <span class="waiting-list-card__stat-value">@liste.NbMedecinsDispo</span>
                                            <span class="waiting-list-card__stat-label">médecin@(liste.NbMedecinsDispo == 1 ? "" : "s") de garde</span>
                                        </div>
                                    </div>
                                    <div class="waiting-list-card__chart">
                                        <canvas id="waiting-list-chart-@liste.ListeAttenteID"
                                                data-waiting-list-chart
                                                data-scheduled="@liste.RendezVousPlanifies"
                                                data-cancelled="@liste.RendezVousAnnules"
                                                data-completed="@liste.ConsultationsTerminees"
                                                role="img"
                                                aria-label="Rendez-vous planifiés : @liste.RendezVousPlanifies, annulés : @liste.RendezVousAnnules, consultations terminées : @liste.ConsultationsTerminees">
                                        </canvas>
                                    </div>
                                </div>
                            </div>

                            <footer class="waiting-list-card__footer">
                                <form asp-area="Cliniques" asp-controller="ListeAttente" asp-action="BasculerDisponibilite"
                                      asp-route-id="@liste.ListeAttenteID" method="post">
                                    <button type="submit"
                                            class="@(liste.IsOuverte ? "button-green-action" : "button-white-action") waiting-list-card__toggle"
                                            aria-label="@(liste.IsOuverte ? "Désactiver" : "Activer") la réservation pour @liste.NomClinique">
                                        @if (liste.IsOuverte)
                                        {
                                            <i class="fa-solid fa-toggle-on" aria-hidden="true"></i>
                                            <span>Disponible pour réservation *</span>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-toggle-off" aria-hidden="true"></i>
                                            <span>NO</span>
                                        }
                                    </button>
                                </form>

                                <nav class="waiting-list-card__actions" aria-label="Actions pour la liste du @liste.DateEffectivite.ToString("dd/MM/yyyy")">
                                    <a asp-area="Cliniques" asp-controller="ListeAttente" asp-action="Edit"
                                       asp-route-id="@liste.ListeAttenteID" class="smBtn button-white-action"
                                       aria-label="Modifier la liste d'attente">
                                        <i class="fa-solid fa-gear" aria-hidden="true"></i>
                                    </a>
                                    <a asp-area="Cliniques" asp-controller="ListeAttente" asp-action="DetailsOrdonnes"
                                       asp-route-id="@liste.ListeAttenteID" class="smBtn button-white-action"
                                       aria-label="Voir les détails de la liste d'attente">
                                        <i class="fa-solid fa-list-ul" aria-hidden="true"></i>
                                    </a>
                                    <a asp-area="Cliniques" asp-controller="ListeAttente" asp-action="Delete"
                                       asp-route-id="@liste.ListeAttenteID" class="smBtn button-white-action"
                                       aria-label="Supprimer la liste d'attente">
                                        <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                    </a>
                                </nav>
                            </footer>
                        </article>
                    </div>
                }
            </div>
        }
    </section>
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        document.querySelectorAll("[data-waiting-list-chart]").forEach((canvas) => {
            new Chart(canvas, {
                type: "doughnut",
                data: {
                    labels: ["Rendez-vous planifiés", "Rendez-vous annulés", "Consultations terminées"],
                    datasets: [{
                        data: [
                            Number(canvas.dataset.scheduled),
                            Number(canvas.dataset.cancelled),
                            Number(canvas.dataset.completed)
                        ],
                        backgroundColor: ["#0d6efd", "#dc3545", "#198754"],
                        borderColor: "#fff",
                        borderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: "62%",
                    plugins: {
                        legend: {
                            position: "bottom",
                            labels: {
                                usePointStyle: true,
                                padding: 14
                            }
                        }
                    }
                }
            });
        });

        const dashboardConnection = new signalR.HubConnectionBuilder()
            .withUrl("/MiseAJourListeAttentePatientHub")
            .withAutomaticReconnect()
            .build();

        dashboardConnection.on("MiseAJourListeSalleDAttentePatient", () => window.location.reload());
        dashboardConnection.start().catch((error) => console.error("Impossible de connecter le tableau de bord en temps réel.", error));
    </script>
}
