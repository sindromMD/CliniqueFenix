@model Clinique

@{
    ViewData["Title"] = "Détails de la clinique";

    var address = Model.Adresse;
    var fullAddress = address == null
        ? "Adresse non renseignée"
        : $"{address.Numero} {address.Rue}, {address.Ville}, {address.Province}, {address.Pays}, {address.CodePostal}";
    var listeAttente = Model.ListeAttente?
        .Where(liste => liste.IsOuverte)
        .OrderByDescending(liste => liste.DateEffectivite)
        .ThenByDescending(liste => liste.ListeAttenteID)
        .FirstOrDefault()
        ?? Model.ListeAttente?
            .OrderByDescending(liste => liste.DateEffectivite)
            .ThenByDescending(liste => liste.ListeAttenteID)
            .FirstOrDefault();
    var patientsEnAttente = listeAttente?.IsOuverte == true
        ? listeAttente.Consultations?.Count(consultation => consultation.StatutConsultation == Clinique2000_Utility.Enum.StatutConsultation.EnAttente) ?? 0
        : 0;
    var moyenneAvis = Model.Critiques?.Any() == true
        ? Model.Critiques.Average(critique => critique.Note).ToString("0.0")
        : "—";
}

<div class="layout-content">
    <div class="container flex-grow-1 container-p-y">
        <div class="row align-items-center mt-5 mb-4">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-light p-3">
                        <i class="fa-solid fa-hospital fa-2xl icons-details-patient" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h1 class="mb-1">@Model.NomClinique</h1>
                        <p class="p1 mb-0">@fullAddress</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 d-flex justify-content-md-end align-items-center gap-3 mt-3 mt-md-0">
                @if (Model.EstActive)
                {
                    <span class="badge rounded-pill text-bg-success px-3 py-2">Ouverte</span>
                }
                else
                {
                    <span class="badge rounded-pill text-bg-secondary px-3 py-2">Fermée</span>
                }
                <a asp-action="Edit" asp-route-id="@Model.CliniqueID" class="button-green-action">
                    <i class="fa-solid fa-pen-to-square me-2" aria-hidden="true"></i>Modifier
                </a>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="fa-solid fa-user-doctor fa-2xl icons-details-patient" aria-hidden="true"></i>
                        <div>
                            <p class="p2 mb-1">Médecins disponibles</p>
                            <h3 class="mb-0">@(listeAttente?.NbMedecinsDispo.ToString() ?? "—")</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="fa-solid fa-users fa-2xl icons-details-patient" aria-hidden="true"></i>
                        <div>
                            <p class="p2 mb-1">Employés</p>
                            <h3 class="mb-0">@(Model.EmployesCliniques?.Count ?? 0)</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="fa-solid fa-clock fa-2xl icons-details-patient" aria-hidden="true"></i>
                        <div>
                            <p class="p2 mb-1">Consultation moyenne</p>
                            <h3 class="mb-0">@Model.TempsMoyenConsultation min</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="fa-solid fa-star fa-2xl icons-details-patient" aria-hidden="true"></i>
                        <div>
                            <p class="p2 mb-1">Note moyenne</p>
                            <h3 class="mb-0">@moyenneAvis <small class="p2">/ 5</small></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6">
                <div class="card mb-4">
                    <div class="card-header p-3">
                        <h2 class="h4 mt-2 mb-0"><i class="fa-solid fa-address-card me-2 icons-details-patient" aria-hidden="true"></i>Coordonnées</h2>
                    </div>
                    <div class="card-body">
                        <dl class="row p-3 mb-0">
                            <dt class="col-sm-4 hr5">Courriel</dt>
                            <dd class="col-sm-8 p1">@(Model.Courriel ?? "Non renseigné")</dd>
                            <dt class="col-sm-4 hr5">Téléphone</dt>
                            <dd class="col-sm-8 p1">@(Model.NumTelephone ?? "Non renseigné")</dd>
                            <dt class="col-sm-4 hr5">Adresse</dt>
                            <dd class="col-sm-8 p1">@fullAddress</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card mb-4">
                    <div class="card-header p-3">
                        <h2 class="h4 mt-2 mb-0"><i class="fa-solid fa-calendar-days me-2 icons-details-patient" aria-hidden="true"></i>Horaires et service</h2>
                    </div>
                    <div class="card-body">
                        <dl class="row p-3 mb-0">
                            <dt class="col-sm-5 hr5">Ouverture</dt>
                            <dd class="col-sm-7 p1">@(Model.HeureOuverture?.ToString(@"hh\:mm") ?? "Non renseignée")</dd>
                            <dt class="col-sm-5 hr5">Fermeture</dt>
                            <dd class="col-sm-7 p1">@(Model.HeureFermeture?.ToString(@"hh\:mm") ?? "Non renseignée")</dd>
                            <dt class="col-sm-5 hr5">Pause</dt>
                            <dd class="col-sm-7 p1">
                                @if (Model.HeurePauseDebut.HasValue && Model.HeurePauseFin.HasValue)
                                {
                                    @($"{Model.HeurePauseDebut.Value:hh\\:mm} – {Model.HeurePauseFin.Value:hh\\:mm}")
                                }
                                else
                                {
                                    @:Aucune pause indiquée
                                }
                            </dd>
                            <dt class="col-sm-5 hr5">Durée moyenne</dt>
                            <dd class="col-sm-7 p1">@Model.TempsMoyenConsultation minutes</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header card-header-datatables h4 text-light d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><i class="fa-solid fa-list-ol me-2" aria-hidden="true"></i>Dernière liste d'attente</span>
                @if (listeAttente != null)
                {
                    @if (listeAttente.IsOuverte)
                    {
                        <span class="badge rounded-pill text-bg-success">Ouverte</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill text-bg-secondary">Fermée</span>
                    }
                }
            </div>
            <div class="card-body">
                @if (listeAttente == null)
                {
                    <p class="p1 mb-0">Aucune liste d'attente n'a encore été créée pour cette clinique.</p>
                }
                else
                {
                    <div class="row g-3 align-items-center">
                        <div class="col-md-3">
                            <p class="p2 mb-1">Date d'effectivité</p>
                            <p class="hr5 mb-0">@listeAttente.DateEffectivite.ToString("d")</p>
                        </div>
                        <div class="col-md-3">
                            <p class="p2 mb-1">Horaire</p>
                            <p class="hr5 mb-0">@listeAttente.HeureOuverture.ToString(@"hh\:mm") – @listeAttente.HeureFermeture.ToString(@"hh\:mm")</p>
                        </div>
                        <div class="col-md-3">
                            <p class="p2 mb-1">Patients en attente</p>
                            <p class="hr5 mb-0">@(listeAttente.IsOuverte ? patientsEnAttente.ToString() : "—")</p>
                        </div>
                        <div class="col-md-3 d-flex flex-wrap gap-2">
                            <a asp-area="Cliniques" asp-controller="ListeAttente" asp-action="DetailsOrdonnes" asp-route-id="@listeAttente.ListeAttenteID" class="button-white-action">
                                <i class="fa-solid fa-calendar-check me-2" aria-hidden="true"></i>Voir l'horaire
                            </a>
                            @if (listeAttente.IsOuverte)
                            {
                                <a asp-area="Cliniques" asp-controller="ListeAttente" asp-action="IndexlisteSalleAttente" asp-route-listeAttenteID="@listeAttente.ListeAttenteID" class="button-green-action">
                                    <i class="fa-solid fa-display me-2" aria-hidden="true"></i>Salle d'attente
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-center mb-5">
            <a href="javascript:history.back()" class="smBtn button-white-action">Retour à la liste</a>
        </div>
    </div>
</div>
