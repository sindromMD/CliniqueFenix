@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject Clinique2000_Services.IServices.IClinique2000Services _service

@if (SignInManager.IsSignedIn(User))
{
    var identityUser = await UserManager.GetUserAsync(User);
    var patient = identityUser is null
        ? null
        : await _service.patient.GetPatientParUserIdAsync(identityUser.Id);

    <li class="nav-item mx-2 d-flex align-items-center">
        @if (patient is not null)
        {
            <a asp-area="Patients" asp-controller="Patients" asp-action="Details" asp-route-id="@patient.PatientId" class="nav-link custom-nav-link">
                Bienvenue : @User.Identity?.Name!
            </a>
        }
        else
        {
            <a asp-area="Patients" asp-controller="Patients" asp-action="Create" class="nav-link custom-nav-link">
                Bienvenue : @User.Identity?.Name!
            </a>
        }
    </li>
    <li class="nav-item mx-2">
        <form id="logoutForm" class="d-flex align-items-center" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="nav-link custom-nav-link">
                <i class="fa-solid fa-right-from-bracket fa-flip-horizontal"></i>
                Déconnexion
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item mx-2">
        <form id="external-account" class="d-flex align-items-center" asp-area="Identity" asp-page="/Account/ExternalLogin" asp-route-returnUrl="@Url.Content("~/")" method="post">
            <button type="submit" class="nav-link custom-nav-link" name="provider" value="Google" title="Log in using your Google account">
                Connexion
                <i class="fa-solid fa-right-to-bracket"></i>
            </button>
        </form>
    </li>
}